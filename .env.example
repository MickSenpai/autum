# URL de tu ServiceDesk Plus Cloud, sin barra final
SDP_BASE_URL=https://tu-empresa.sdpondemand.manageengine.com

# Bot de Telegram (créalo con @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcionales
# POLL_SECONDS=60
# REMINDER_MINUTES=2
# Vista de la bandeja que se vigila (nombre tal como aparece en los accesos rápidos)
# SDP_VIEW_NAME=Unassigned Requests
# ID numérico de la vista; si se define, tiene prioridad sobre el nombre
# SDP_VIEW_ID=
# HEADLESS=false
